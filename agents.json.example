{
  "_comment": "Agent configuration for asdaaas. Copy to agents.json and edit for your machine. DO NOT commit agents.json — it contains local paths and session IDs.",
  "settings": {
    "asdaaas_dir": "/home/YOURUSER/agent-abide",
    "agents_dir": "/home/YOURUSER/agents",
    "log_dir": "/tmp",
    "running_agents_file": "/home/YOURUSER/agents/running_agents.json",
    "timezone": "America/Los_Angeles",
    "debug": false,
    "grok_binary": "/home/YOURUSER/.grok/bin/grok"
  },
  "agents": {},
  "adapters": {
    "context": {
      "script": "adapters/context_adapter.py",
      "log": "context_adapter.log"
    },
    "session": {
      "script": "adapters/session_adapter.py",
      "log": "session_adapter.log"
    },
    "heartbeat": {
      "script": "adapters/heartbeat_adapter.py",
      "log": "heartbeat_adapter.log"
    },
    "irc": {
      "script": "scripts/launch_irc_adapter.sh",
      "log": "irc_adapter.log"
    },
    "localmail": {
      "script": "adapters/localmail_adapter.py",
      "log": "localmail_adapter.log"
    },
    "remind": {
      "script": "scripts/launch_remind.sh",
      "log": "remind_adapter.log"
    }
  }
}
